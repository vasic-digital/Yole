# Yole — Environment Configuration (TEMPLATE)
# ===========================================
# Copy this file to .env and fill in your actual values.
# .env is git-ignored and MUST NEVER be committed.
# Tokens here are SAMPLES, not real credentials.

# ---------------------------------------------------------------------------
# Firebase — required for scripts/distribute.sh
# ---------------------------------------------------------------------------
# Firebase CI token. Generate: `firebase login:ci`.
# Safer alternative: export FIREBASE_CLI_TOKEN in your shell instead of
# writing it here. distribute.sh prefers env vars over .env values.
FIREBASE_CLI_TOKEN=1//your-firebase-token-here

# Project + app IDs (these are PUBLIC — same in dev/prod).
FIREBASE_PROJECT_ID=yole-app
FIREBASE_ANDROID_APP_ID=1:578988389676:android:d61715a0a84a42c65d2889
# iOS / Web are placeholders until those apps are registered in Firebase.
# FIREBASE_IOS_APP_ID=1:578988389676:ios:...
# FIREBASE_WEB_APP_ID=1:578988389676:web:...

# Comma-separated tester emails. Each receives a Firebase App Distribution
# invite on every `bash scripts/distribute.sh` run.
FIREBASE_TESTER_GROUP=tester1@example.com,tester2@example.com,tester3@example.com

# ---------------------------------------------------------------------------
# Git credentials (optional — only needed for automated push from CI)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_yourgithubtoken
# GITLAB_TOKEN=glpat-yourgitlabtoken

# ---------------------------------------------------------------------------
# API Keys (optional — only for app features that integrate LLM providers)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
