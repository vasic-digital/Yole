# Yole - Environment Configuration
# =================================
# Copy this file to .env and fill in your actual values.
# .env is git-ignored and MUST NEVER be committed.
#
# GENERATED: 2026-05-08
# See scripts/distribute.sh for Firebase Distribution workflow.

# ---------------------------------------------------------------------------
# Firebase
# ---------------------------------------------------------------------------
# Firebase CLI token for CI/CD authentication.
# Generate: firebase login:ci
FIREBASE_CLI_TOKEN=1//your-firebase-token-here

# Firebase project and app identifiers.
# Create them: firebase projects:create <id>
FIREBASE_PROJECT_ID=yole-app
FIREBASE_ANDROID_APP_ID=1:123456789:android:abcdef
FIREBASE_WEB_APP_ID=1:123456789:web:abcdef
FIREBASE_IOS_APP_ID=1:123456789:ios:abcdef

# Comma-separated list of tester email addresses.
# These accounts receive Firebase App Distribution invites.
FIREBASE_TESTER_GROUP=tester1@example.com,tester2@example.com,tester3@example.com

# ---------------------------------------------------------------------------
# Go API
# ---------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-here

# ---------------------------------------------------------------------------
# Git credentials (optional, for automated builds)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=ghp_yourgithubtoken
GITLAB_TOKEN=glpat-yourgitlabtoken

# ---------------------------------------------------------------------------
# API Keys (optional, for LLM provider integrations)
# ---------------------------------------------------------------------------
# See individual provider documentation for key generation.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# etc.
