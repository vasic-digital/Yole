package digital.vasic.yole.format.{{FORMAT_PACKAGE}}

import androidx.compose.ui.test.*
import androidx.compose.ui.test.junit4.createComposeRule
import digital.vasic.yole.format.{{FORMAT_PACKAGE}}.ui.{{FORMAT_CLASS}}Editor
import digital.vasic.yole.format.{{FORMAT_PACKAGE}}.ui.{{FORMAT_CLASS}}Preview
import org.junit.Rule
import org.junit.Test
import org.junit.runner.RunWith
import org.junit.runners.JUnit4

/**
 * UI tests for {{FORMAT_NAME}} format components.
 *
 * Tests cover:
 * - Editor component rendering
 * - Preview component rendering
 * - User interaction handling
 * - State management
 * - Accessibility features
 */
@RunWith(JUnit4::class)
class {{FORMAT_CLASS}}UITest {

    @get:Rule
    val composeTestRule = createComposeRule()

    // ==================== Editor Component Tests ====================

    @Test
    fun `should render {{FORMAT_NAME}} editor correctly`() {
        composeTestRule.setContent {
            {{FORMAT_CLASS}}Editor(
                content = "{{SAMPLE_CONTENT}}",
                onContentChange = {}
            )
        }

        // Verify editor is displayed
        composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_editor")
            .assertExists()
            .assertIsDisplayed()
    }

    @Test
    fun `should handle content changes in editor`() {
        var contentChanged = false
        var newContent = ""

        composeTestRule.setContent {
            {{FORMAT_CLASS}}Editor(
                content = "{{SINGLE_LINE_SAMPLE}}",
                onContentChange = { content ->
                    contentChanged = true
                    newContent = content
                }
            )
        }

        // Find and interact with editor
        composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_editor")
            .performTextClearance()
            .performTextInput("{{FORMAT_SPECIFIC_SAMPLE}}")

        // Verify content change was triggered
        assert(contentChanged) { "Content change callback should be triggered" }
        assert(newContent == "{{FORMAT_SPECIFIC_SAMPLE}}") { "New content should match input" }
    }

    @Test
    fun `should display placeholder when content is empty`() {
        composeTestRule.setContent {
            {{FORMAT_CLASS}}Editor(
                content = "",
                onContentChange = {},
                placeholder = "Enter {{FORMAT_NAME}} content..."
            )
        }

        // Verify placeholder text is displayed
        composeTestRule.onNodeWithText("Enter {{FORMAT_NAME}} content...")
            .assertExists()
            .assertIsDisplayed()
    }

    // ==================== Preview Component Tests ====================

    @Test
    fun `should render {{FORMAT_NAME}} preview correctly`() {
        composeTestRule.setContent {
            {{FORMAT_CLASS}}Preview(
                content = "{{SAMPLE_CONTENT}}",
                isDarkTheme = false
            )
        }

        // Verify preview is displayed
        composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_preview")
            .assertExists()
            .assertIsDisplayed()
    }

    @Test
    fun `should handle dark theme in preview`() {
        composeTestRule.setContent {
            {{FORMAT_CLASS}}Preview(
                content = "{{SAMPLE_CONTENT}}",
                isDarkTheme = true
            )
        }

        // Verify preview adapts to dark theme
        composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_preview")
            .assertExists()
            .assertIsDisplayed()
    }

    @Test
    fun `should update preview when content changes`() {
        var content = "{{SINGLE_LINE_SAMPLE}}"

        composeTestRule.setContent {
            {{FORMAT_CLASS}}Preview(
                content = content,
                isDarkTheme = false
            )
        }

        // Update content
        content = "{{FORMAT_SPECIFIC_SAMPLE}}"
        composeTestRule.setContent {
            {{FORMAT_CLASS}}Preview(
                content = content,
                isDarkTheme = false
            )
        }

        // Verify preview updated
        composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_preview")
            .assertExists()
            .assertIsDisplayed()
    }

    // ==================== Integration Tests ====================

    @Test
    fun `should integrate editor and preview components`() {
        var editorContent = "{{SAMPLE_CONTENT}}"

        composeTestRule.setContent {
            Column {
                {{FORMAT_CLASS}}Editor(
                    content = editorContent,
                    onContentChange = { newContent ->
                        editorContent = newContent
                    }
                )
                {{FORMAT_CLASS}}Preview(
                    content = editorContent,
                    isDarkTheme = false
                )
            }
        }

        // Verify both components are displayed
        composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_editor")
            .assertExists()
            .assertIsDisplayed()

        composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_preview")
            .assertExists()
            .assertIsDisplayed()
    }

    // ==================== Accessibility Tests ====================

    @Test
    fun `should support accessibility features in editor`() {
        composeTestRule.setContent {
            {{FORMAT_CLASS}}Editor(
                content = "{{SAMPLE_CONTENT}}",
                onContentChange = {},
                contentDescription = "{{FORMAT_NAME}} content editor"
            )
        }

        // Verify accessibility features
        composeTestRule.onNodeWithContentDescription("{{FORMAT_NAME}} content editor")
            .assertExists()
            .assertIsDisplayed()
    }

    @Test
    fun `should support accessibility features in preview`() {
        composeTestRule.setContent {
            {{FORMAT_CLASS}}Preview(
                content = "{{SAMPLE_CONTENT}}",
                isDarkTheme = false,
                contentDescription = "{{FORMAT_NAME}} content preview"
            )
        }

        // Verify accessibility features
        composeTestRule.onNodeWithContentDescription("{{FORMAT_NAME}} content preview")
            .assertExists()
            .assertIsDisplayed()
    }

    // ==================== Error Handling Tests ====================

    @Test
    fun `should handle malformed content gracefully`() {
        composeTestRule.setContent {
            {{FORMAT_CLASS}}Editor(
                content = "{{MALFORMED_SAMPLE}}",
                onContentChange = {}
            )
        }

        // Should not crash with malformed content
        composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_editor")
            .assertExists()
            .assertIsDisplayed()
    }

    @Test
    fun `should handle very long content`() {
        val longContent = "{{SINGLE_LINE_SAMPLE}}\n".repeat(1000)

        composeTestRule.setContent {
            {{FORMAT_CLASS}}Editor(
                content = longContent,
                onContentChange = {}
            )
        }

        // Should handle long content without performance issues
        composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_editor")
            .assertExists()
            .assertIsDisplayed()
    }

