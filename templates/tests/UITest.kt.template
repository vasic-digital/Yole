    // ==================== Performance Tests ====================

    @Test
    fun `should maintain responsive UI with rapid content changes`() {
        var content = "{{SINGLE_LINE_SAMPLE}}"

        composeTestRule.setContent {
            {{FORMAT_CLASS}}Editor(
                content = content,
                onContentChange = { newContent ->
                    content = newContent
                }
            )
        }

        // Simulate rapid typing
        repeat(10) { i ->
            composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_editor")
                .performTextInput("Line $i\n")
        }

        // UI should remain responsive
        composeTestRule.onNodeWithTag("{{FORMAT_LOWERCASE}}_editor")
            .assertExists()
            .assertIsDisplayed()
    }
}