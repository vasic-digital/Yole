{
  "name": "Yole Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#212121",
    "editorLineNumber.foreground": "#6e6e6e",
    "editorLineNumber.activeForeground": "#6e6e6e",
    "statusBar.background": "#e8e8e8",
    "statusBar.foreground": "#757575",
    "activityBar.background": "#dddddd",
    "activityBar.foreground": "#212121",
    "sideBar.background": "#f3f3f3",
    "editorWidget.background": "#f3f3f3",
    "editorWidget.border": "#d4d4d4",
    "focusBorder": "#d32f2f",
    "badge.background": "#d32f2f",
    "editor.lineHighlightBackground": "#f0f0f0",
    "tab.inactiveBackground": "#ececec",
    "tab.activeBackground": "#ffffff",
    "menu.selectionBackground": "#e8e8e8"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": { "foreground": "#008000", "fontStyle": "italic" }
    },
    {
      "scope": "keyword",
      "settings": { "foreground": "#0000ff" }
    },
    {
      "scope": "string",
      "settings": { "foreground": "#a31515" }
    },
    {
      "scope": "constant",
      "settings": { "foreground": "#098658" }
    },
    {
      "scope": "entity.name.function",
      "settings": { "foreground": "#795e26" }
    },
    {
      "scope": "entity.name.type",
      "settings": { "foreground": "#267f99" }
    },
    {
      "scope": "variable",
      "settings": { "foreground": "#001080" }
    }
  ]
}
