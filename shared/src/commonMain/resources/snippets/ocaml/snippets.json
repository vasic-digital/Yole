{
  "Let binding": {
    "prefix": "let",
    "body": "let ${1:name} = ${0}",
    "description": "Let binding"
  },
  "Function": {
    "prefix": "fun",
    "body": "let ${1:name} ${2:arg} = ${0}",
    "description": "Function definition"
  },
  "Recursive function": {
    "prefix": "rec",
    "body": "let rec ${1:name} ${2:arg} = ${0}",
    "description": "Recursive function"
  },
  "Type": {
    "prefix": "type",
    "body": "type ${1:name} = ${0}",
    "description": "Type definition"
  },
  "Match": {
    "prefix": "match",
    "body": ["match ${1:expr} with", "| ${2:pattern} -> ${3}", "| _ -> ${0}"],
    "description": "Match expression"
  },
  "Module": {
    "prefix": "module",
    "body": ["module ${1:Name} = struct", "\t${0}", "end"],
    "description": "Module definition"
  },
  "Printf": {
    "prefix": "pf",
    "body": "Printf.printf \"${1:%s}\\n\" ${0}",
    "description": "Printf statement"
  }
}
