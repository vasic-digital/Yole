{
  "Function": {
    "prefix": "fun",
    "body": ["${1:void} ${2:name}(${3:params}) {", "\t${0}", "}"],
    "description": "Function definition"
  },
  "Main": {
    "prefix": "main",
    "body": ["int main(int argc, char *argv[]) {", "\t${0}", "\treturn 0;", "}"],
    "description": "Main function"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["typedef struct {", "\t${1:int} ${2:field};", "} ${3:Name};"],
    "description": "Typedef struct"
  },
  "For loop": {
    "prefix": "for",
    "body": ["for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {", "\t${0}", "}"],
    "description": "For loop"
  },
  "Printf": {
    "prefix": "pf",
    "body": "printf(\"${1:%s}\\n\", ${0});",
    "description": "printf"
  },
  "Include": {
    "prefix": "inc",
    "body": "#include <${1:stdio.h}>",
    "description": "#include directive"
  },
  "Define": {
    "prefix": "def",
    "body": "#define ${1:NAME} ${0}",
    "description": "#define macro"
  }
}
