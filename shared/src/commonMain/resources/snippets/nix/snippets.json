{
  "Let-in": {
    "prefix": "let",
    "body": ["let", "\t${1:name} = ${2:value};", "in", "\t${0}"],
    "description": "Let-in expression"
  },
  "Attrset": {
    "prefix": "attr",
    "body": ["{ ${1:key} = ${2:value}; ${0} }"],
    "description": "Attribute set"
  },
  "With": {
    "prefix": "with",
    "body": "with ${1:pkgs}; ${0}",
    "description": "With expression"
  },
  "Derivation": {
    "prefix": "drv",
    "body": [
      "stdenv.mkDerivation {",
      "\tname = \"${1:package}\";",
      "\tsrc = ${2:./.};",
      "\t${0}",
      "}"
    ],
    "description": "Nix derivation"
  },
  "Function": {
    "prefix": "fun",
    "body": "${1:arg}: ${0}",
    "description": "Function (lambda)"
  },
  "Import": {
    "prefix": "import",
    "body": "import ${0:./default.nix}",
    "description": "Import expression"
  }
}
