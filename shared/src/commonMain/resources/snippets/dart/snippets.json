{
  "Class": {
    "prefix": "class",
    "body": ["class ${1:Name} {", "\t${1:Name}({${2:required this.field}});", "\t${0}", "}"],
    "description": "Dart class"
  },
  "Stateful widget": {
    "prefix": "stf",
    "body": [
      "class ${1:Name} extends StatefulWidget {",
      "\tconst ${1:Name}({super.key});",
      "",
      "\t@override",
      "\tState<${1:Name}> createState() => _${1:Name}State();",
      "}",
      "",
      "class _${1:Name}State extends State<${1:Name}> {",
      "\t@override",
      "\tWidget build(BuildContext context) {",
      "\t\treturn ${0:Container()};",
      "\t}",
      "}"
    ],
    "description": "StatefulWidget"
  },
  "Stateless widget": {
    "prefix": "stl",
    "body": [
      "class ${1:Name} extends StatelessWidget {",
      "\tconst ${1:Name}({super.key});",
      "",
      "\t@override",
      "\tWidget build(BuildContext context) {",
      "\t\treturn ${0:Container()};",
      "\t}",
      "}"
    ],
    "description": "StatelessWidget"
  },
  "Print": {
    "prefix": "print",
    "body": "print('${0}');",
    "description": "print statement"
  },
  "Async function": {
    "prefix": "async",
    "body": ["Future<${1:void}> ${2:name}() async {", "\t${0}", "}"],
    "description": "Async function"
  }
}
