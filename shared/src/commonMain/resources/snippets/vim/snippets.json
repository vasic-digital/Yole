{
  "Function": {
    "prefix": "fun",
    "body": ["function! ${1:Name}(${2:args})", "\t${0}", "endfunction"],
    "description": "Vimscript function"
  },
  "If-else": {
    "prefix": "if",
    "body": ["if ${1:condition}", "\t${2}", "else", "\t${0}", "endif"],
    "description": "If-else block"
  },
  "For loop": {
    "prefix": "for",
    "body": ["for ${1:var} in ${2:list}", "\t${0}", "endfor"],
    "description": "For loop"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while ${1:condition}", "\t${0}", "endwhile"],
    "description": "While loop"
  },
  "Autocommand": {
    "prefix": "au",
    "body": "autocmd ${1:BufEnter} ${2:*} ${0}",
    "description": "Autocommand"
  },
  "Echo": {
    "prefix": "echo",
    "body": "echo '${0}'",
    "description": "Echo message"
  }
}
