{
  "Class": {
    "prefix": "class",
    "body": ["class ${1:Name} {", "public:", "\t${0}", "};"],
    "description": "Class declaration"
  },
  "Constructor": {
    "prefix": "ctor",
    "body": ["${1:Name}::${1:Name}(${2:params}) {", "\t${0}", "}"],
    "description": "Constructor definition"
  },
  "Function": {
    "prefix": "fun",
    "body": ["${1:void} ${2:name}(${3:params}) {", "\t${0}", "}"],
    "description": "Function definition"
  },
  "Main": {
    "prefix": "main",
    "body": ["int main(int argc, char* argv[]) {", "\t${0}", "\treturn 0;", "}"],
    "description": "Main function"
  },
  "Cout": {
    "prefix": "cout",
    "body": "std::cout << ${1} << std::endl;",
    "description": "std::cout"
  },
  "Include": {
    "prefix": "inc",
    "body": "#include <${1:iostream}>",
    "description": "#include directive"
  },
  "Namespace": {
    "prefix": "ns",
    "body": ["namespace ${1:name} {", "\t${0}", "}"],
    "description": "Namespace block"
  },
  "Template": {
    "prefix": "tmpl",
    "body": ["template<typename ${1:T}>", "${2:void} ${3:name}(${1:T} ${4:arg}) {", "\t${0}", "}"],
    "description": "Template function"
  }
}
