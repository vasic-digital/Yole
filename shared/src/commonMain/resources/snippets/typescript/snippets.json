{
  "Interface": {
    "prefix": "interface",
    "body": ["interface ${1:Name} {", "\t${2:key}: ${3:string};", "}"],
    "description": "TypeScript interface"
  },
  "Type alias": {
    "prefix": "type",
    "body": "type ${1:Name} = ${0};",
    "description": "Type alias"
  },
  "Arrow function typed": {
    "prefix": "af",
    "body": "const ${1:name} = (${2:params}): ${3:void} => {${0}};",
    "description": "Typed arrow function"
  },
  "Async function": {
    "prefix": "async",
    "body": ["async function ${1:name}(${2:params}): Promise<${3:void}> {", "\t${0}", "}"],
    "description": "Async function"
  },
  "Enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:Value} = '${3:value}',", "}"],
    "description": "TypeScript enum"
  },
  "Generic function": {
    "prefix": "gfun",
    "body": ["function ${1:name}<${2:T}>(${3:arg}: ${2:T}): ${2:T} {", "\t${0}", "}"],
    "description": "Generic function"
  },
  "Import type": {
    "prefix": "imt",
    "body": "import type { ${1:Type} } from '${2:module}';",
    "description": "Import type"
  }
}
