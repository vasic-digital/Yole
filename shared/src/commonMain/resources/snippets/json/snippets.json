{
  "Object": {
    "prefix": "obj",
    "body": ["{\n\t\"${1:key}\": \"${2:value}\"${0}\n}"],
    "description": "JSON object"
  },
  "Array": {
    "prefix": "arr",
    "body": ["[", "\t\"${1}\"${0}", "]"],
    "description": "JSON array"
  },
  "Key-value pair": {
    "prefix": "kv",
    "body": "\"${1:key}\": \"${2:value}\"",
    "description": "Key-value pair"
  },
  "Nested object": {
    "prefix": "nested",
    "body": ["\"${1:key}\": {", "\t\"${2:field}\": \"${3:value}\"${0}", "}"],
    "description": "Nested object"
  }
}
