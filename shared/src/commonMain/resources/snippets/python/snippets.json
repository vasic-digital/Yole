{
  "Function": {
    "prefix": "def",
    "body": ["def ${1:name}(${2:args}):", "\t${0}"],
    "description": "Function definition"
  },
  "Class": {
    "prefix": "class",
    "body": ["class ${1:Name}:", "\tdef __init__(self${2:, args}):", "\t\t${0}"],
    "description": "Class definition"
  },
  "If-else": {
    "prefix": "if",
    "body": ["if ${1:condition}:", "\t${2}", "else:", "\t${0}"],
    "description": "If-else block"
  },
  "For loop": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:iterable}:", "\t${0}"],
    "description": "For loop"
  },
  "With statement": {
    "prefix": "with",
    "body": ["with open(${1:'file'}, '${2:r}') as ${3:f}:", "\t${0}"],
    "description": "With / context manager"
  },
  "Try-except": {
    "prefix": "try",
    "body": ["try:", "\t${1}", "except ${2:Exception} as ${3:e}:", "\t${0}"],
    "description": "Try-except block"
  },
  "List comprehension": {
    "prefix": "lc",
    "body": "[${1:expr} for ${2:item} in ${3:iterable}]",
    "description": "List comprehension"
  },
  "Print": {
    "prefix": "print",
    "body": "print(${0})",
    "description": "Print statement"
  }
}
